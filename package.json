{
    "name": "little-cubes",
    "version": "0.0.1",
    "description": "Just a modular, web-based voxel building game I created for my kids",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && node scripts/post-build.js",
        "preview": "vite preview",
        "lint": "eslint src/**/*.js",
        "lint:fix": "eslint src/**/*.js --fix",
        "format": "prettier --write \"src/**/*.js\" \"*.{json,md,html,css}\"",
        "format:check": "prettier --check \"src/**/*.js\" \"*.{json,md,html,css}\"",
        "check": "npm run lint && npm run format:check",
        "fix": "npm run lint:fix && npm run format"
    },
    "keywords": [
        "little-cubes",
        "game",
        "voxel",
        "3d",
        "webgl"
    ],
    "author": "Pau Garcia-Mila",
    "license": "MIT",
    "dependencies": {
        "idb-keyval": "^6.3.0",
        "three": "^0.186.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "vite": "^8.3.5",
        "vite-plugin-singlefile": "^2.3.4"
    }
}
